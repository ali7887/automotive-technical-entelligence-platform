# Copy to docker/.env.secrets — CREDENTIALS ONLY. Then:
#   chmod 600 docker/.env.secrets
# Never commit, never echo, never paste into logs or tickets.
# Keep comments on their own lines — no inline comments after values.

# --- PostgreSQL ---
# Generate the password with: openssl rand -hex 24
# The user must NOT be atip:atip — the api refuses to boot on dev credentials.
POSTGRES_USER=atip_app
POSTGRES_PASSWORD=change-me-openssl-rand-hex-24
POSTGRES_DB=atip
# Must embed the same user/password; host is the compose service name.
DATABASE_URL=postgresql+asyncpg://atip_app:change-me-openssl-rand-hex-24@postgres:5432/atip

# --- LLM provider (OPTIONAL) ---
# Unset = keyword-only search, no answer generation. The API degrades
# gracefully; it does not fail.
OPENAI_API_KEY=
OPENAI_BASE_URL=
