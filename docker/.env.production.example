# Copy to docker/.env.production — NON-SECRET production configuration.
# Anything with a credential belongs in docker/.env.secrets instead.
# Used twice: compose variable interpolation (scripts/ops/compose.sh passes
# --env-file) and as container environment for api/migrate (env_file:).
# Keep comments on their own lines — no inline comments after values.

# --- Deploy identity ---
# Public domain the stack serves (DNS A/AAAA record must point at this host).
ATIP_DOMAIN=atip.example.com
# Let's Encrypt account email (expiry warnings land here).
ACME_EMAIL=ops@example.com
# Image tag for atip-api/atip-web; scripts/ops/deploy.sh sets both of these
# to the released git SHA.
ATIP_TAG=set-by-deploy
BUILD_SHA=set-by-deploy

# --- API runtime (container-network endpoints; service names, not hosts) ---
ENVIRONMENT=production
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=atip_chunks
STORAGE_DIR=/data/uploads
# Must be exactly https://<ATIP_DOMAIN> (env files don't interpolate).
CORS_ORIGINS=https://atip.example.com
LOG_LEVEL=INFO
LOG_JSON=true
RATE_LIMIT_ENABLED=true

# --- Async ingestion (worker container consumes the queue) ---
# true: uploads are queued to the arq worker service. If redis is briefly
# unavailable the api falls back to in-process processing (logged).
QUEUE_ENABLED=true
JOB_TIMEOUT_SECONDS=900
JOB_MAX_TRIES=3
JOB_STALE_AFTER_SECONDS=1800

# --- Sessions (cookie flags are Secure+HttpOnly+Strict in production) ---
SESSION_TTL_HOURS=336
RATE_LIMIT_LOGIN_PER_MINUTE=10
# Bootstrap the first account after the first deploy (no public signup):
#   ATIP_BOOTSTRAP_PASSWORD=... scripts/ops/compose.sh run --rm api \
#     python -m atip_api.cli create-user --email you@company.com \
#     --org "Your Org" --role org_admin

# --- AI models (key itself lives in .env.secrets) ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
LLM_MODEL=gpt-4o-mini

# --- Local-validation escape hatch only; never set in production ---
# HTTP_PORT=8080
# HTTPS_PORT=8443
