# Leave NEXT_PUBLIC_API_URL unset (or empty) for the same-origin setup: dev
# proxies /api/* to the API via next.config.ts rewrites, production routes it
# at the reverse proxy. If set, it must be same-site with the web origin or
# the HttpOnly session cookie will not be sent.
NEXT_PUBLIC_API_URL=

# Where the dev rewrite proxy forwards /api/* (next dev only).
ATIP_DEV_API_PROXY=http://127.0.0.1:8000
