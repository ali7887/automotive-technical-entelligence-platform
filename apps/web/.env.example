# The web app runs in one of two modes.
#
# ── Real authenticated mode (default; flag unset) ─────────────────────────
# Talks to a live API and uses the HttpOnly SameSite=Strict session cookie.
# Requires the API to be same-origin with the web app (dev proxies /api/*
# via next.config.ts rewrites; production routes it at a reverse proxy).
#
# ── API-less demo mode (NEXT_PUBLIC_DEMO_MODE=true) ───────────────────────
# No backend required: the browser client serves /api/* from static fixtures
# (src/lib/api/demo/*) and synthesizes the Ask AI stream. Login/signup are
# skipped, the app is entered directly, and writes return a read-only notice.
# This is the mode to deploy for a frictionless showcase (e.g. Vercel).

# Leave NEXT_PUBLIC_API_URL empty in BOTH modes:
#   - demo mode: nothing hits the network, so an API URL is meaningless.
#   - real mode: same-origin is required; a value must be same-site with the
#     web origin or the session cookie will not be sent. Set it only under a
#     unified single-origin deployment (== the public web origin).
NEXT_PUBLIC_API_URL=

# API-less demo mode. true = backend-free showcase (see above). This is a
# NEXT_PUBLIC_ var, so it is baked in at build time — set it in the Vercel
# project env and redeploy (or restart `next dev`) after changing it.
# Unset / false = normal authenticated flow, unchanged.
NEXT_PUBLIC_DEMO_MODE=

# Real-mode only, dev only: where the Next rewrite proxy forwards /api/*.
# Unused in demo mode and irrelevant on Vercel (no live API there).
ATIP_DEV_API_PROXY=http://127.0.0.1:8000

# Note: DEMO_LOGIN_EMAIL / DEMO_LOGIN_PASSWORD are obsolete. They belonged to
# an earlier demo variant that logged into a live API; API-less demo mode does
# not use them. Do not set them.
