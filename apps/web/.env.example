# Authentication is DISABLED in this build: no login/signup, every request runs
# as a default admin (see README "Authentication"). The web app still calls the
# API same-origin.
#
# ── Default: live API, no auth ────────────────────────────────────────────
# Talks to the API same-origin (dev proxies /api/* via next.config.ts rewrites;
# production routes it at a reverse proxy). No cookie is used.
#
# ── Optional API-less demo mode (NEXT_PUBLIC_DEMO_MODE=true) ───────────────
# No backend required: the browser client serves /api/* from static fixtures
# (src/lib/api/demo/*) and synthesizes the Ask AI stream; writes are read-only.
# For a frictionless backend-free showcase (e.g. Vercel). Off by default.

# Leave NEXT_PUBLIC_API_URL empty in both cases:
#   - demo mode: nothing hits the network, so an API URL is meaningless.
#   - live API: same-origin is required; set it only under a unified
#     single-origin deployment (== the public web origin).
NEXT_PUBLIC_API_URL=

# Optional API-less demo mode. Default (empty/false) = the real product against
# the live API (auth disabled). Set true ONLY for a backend-free showcase. This
# is a NEXT_PUBLIC_ var baked in at build time, so set it in the Vercel project
# env and redeploy (or restart `next dev`) after changing it.
NEXT_PUBLIC_DEMO_MODE=false

# Real-mode only, dev only: where the Next rewrite proxy forwards /api/*.
# Unused in demo mode and irrelevant on Vercel (no live API there).
ATIP_DEV_API_PROXY=http://127.0.0.1:8000

# Note: DEMO_LOGIN_EMAIL / DEMO_LOGIN_PASSWORD are obsolete. They belonged to
# an earlier demo variant that logged into a live API; API-less demo mode does
# not use them. Do not set them.
