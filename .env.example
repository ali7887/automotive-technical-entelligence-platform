# --- API (apps/api reads this via pydantic-settings) ---
DATABASE_URL=postgresql+asyncpg://atip:atip@127.0.0.1:5433/atip
REDIS_URL=redis://127.0.0.1:6380/0
QDRANT_URL=http://127.0.0.1:6335
QDRANT_COLLECTION=atip_chunks
EMBEDDING_DIM=1536
EMBEDDING_MODEL=text-embedding-3-small

# OpenAI-compatible embeddings endpoint. If OPENAI_API_KEY is unset, documents
# are still chunked and keyword-searchable, but semantic search is disabled.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Reciprocal Rank Fusion constant for hybrid retrieval
RRF_K=60

# Local file storage for uploaded PDFs (dev)
STORAGE_DIR=./storage/uploads
MAX_UPLOAD_MB=50

# CORS: comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
