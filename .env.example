# ATIP environment reference. Copy to apps/api/.env (API) and set
# NEXT_PUBLIC_API_URL in apps/web/.env.local (web). Every variable has a safe
# development default in code; production requirements are marked below.

# --- Deployment stage ---
# development | test | production. "production" enables fail-fast startup
# checks (dev DB credentials and relative STORAGE_DIR are rejected).
ENVIRONMENT=development
# Optional release identifier (e.g. git SHA) surfaced by /health/live.
# Set by the deploy pipeline; leave empty locally.
BUILD_SHA=

# --- Core services (REQUIRED in production) ---
# Dev defaults use 127.0.0.1 and the docker/docker-compose.yml host ports.
# Production MUST override DATABASE_URL: startup refuses the atip:atip default.
DATABASE_URL=postgresql+asyncpg://atip:atip@127.0.0.1:5433/atip
REDIS_URL=redis://127.0.0.1:6380/0
QDRANT_URL=http://127.0.0.1:6335
QDRANT_COLLECTION=atip_chunks

# --- AI provider (OPTIONAL — secret) ---
# OpenAI-compatible endpoint. If OPENAI_API_KEY is unset: documents are still
# chunked and keyword-searchable, but semantic search and answer generation
# are disabled (the API degrades, it does not fail). Never commit a real key.
OPENAI_API_KEY=
OPENAI_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
LLM_MODEL=gpt-4o-mini

# --- Timeouts & retrieval tuning (optional) ---
OPENAI_TIMEOUT_SECONDS=60
QDRANT_TIMEOUT_SECONDS=10
# Reciprocal Rank Fusion constant for hybrid retrieval
RRF_K=60

# --- Reranking (OPTIONAL — off by default) ---
# Cross-encoder reranking of fused candidates via a Cohere/Jina/TEI-compatible
# HTTP endpoint. If disabled, unreachable, or failing, search silently keeps
# the RRF ordering (rerank_used=false in responses). RERANK_API_KEY is secret.
RERANK_ENABLED=false
RERANK_URL=
RERANK_MODEL=
RERANK_API_KEY=
RERANK_TIMEOUT_SECONDS=10
# fused candidates sent to the reranker per query (>= top_k)
RERANK_CANDIDATES=30

# --- Async ingestion queue (OPTIONAL — off by default) ---
# true: uploads are processed by the arq worker (`uv run arq
# atip_api.worker.WorkerSettings`, its own container in production).
# false (dev/test default) or Redis unreachable: processing falls back to an
# in-process background task, exactly the pre-queue behavior.
QUEUE_ENABLED=false
JOB_TIMEOUT_SECONDS=900
JOB_MAX_TRIES=3
# PENDING/PROCESSING jobs older than this are failed lazily on read
JOB_STALE_AFTER_SECONDS=1800

# --- Sessions & auth ---
# Opaque revocable session tokens in an HttpOnly SameSite=Strict cookie.
# SESSION_COOKIE_SECURE defaults by environment (Secure flag on in production).
SESSION_COOKIE_NAME=atip_session
SESSION_TTL_HOURS=336
RATE_LIMIT_LOGIN_PER_MINUTE=10
# Public self-service signup (POST /api/auth/register): each account creates a
# new organization and its first org_admin. Per-client-IP limit (abuse guard):
RATE_LIMIT_REGISTER_PER_MINUTE=5
# The CLI still provisions accounts directly (e.g. platform_admins, or seeding
# a user into an existing org without opening signup):
#   ATIP_BOOTSTRAP_PASSWORD=... uv run python -m atip_api.cli create-user \
#     --email you@company.com --org "Your Org" --role org_admin

# --- Uploads (STORAGE_DIR REQUIRED absolute in production) ---
# Local filesystem storage for uploaded PDFs. Must be a persistent volume and
# an absolute path in production.
STORAGE_DIR=./storage/uploads
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=2000

# --- HTTP surface ---
# Comma-separated origins allowed to call the API. Set to the deployed web
# origin(s) in production; loopback origins there only log a warning.
CORS_ORIGINS=http://localhost:3000

# --- Logging ---
# LOG_JSON=true emits one JSON object per line (production default);
# false switches to plain text for local debugging.
LOG_LEVEL=INFO
LOG_JSON=true

# --- Rate limiting (per client IP, per minute, in-memory/single-process) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ASK_PER_MINUTE=30
RATE_LIMIT_EXTRACT_PER_MINUTE=10

# --- Web (apps/web/.env.local) ---
# Leave empty for the same-origin setup (dev: next.config.ts rewrites proxy
# /api/*; production: the reverse proxy routes it). If set, it must be
# same-site with the web origin or the session cookie will not flow.
NEXT_PUBLIC_API_URL=
# Dev-only: where the Next rewrite proxy forwards /api/*.
ATIP_DEV_API_PROXY=http://127.0.0.1:8000
