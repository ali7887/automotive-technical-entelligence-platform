# --- API (apps/api reads this via pydantic-settings) ---
DATABASE_URL=postgresql+asyncpg://atip:atip@localhost:5432/atip
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=atip_chunks
EMBEDDING_DIM=1536

# Local file storage for uploaded PDFs (dev)
STORAGE_DIR=./storage/uploads
MAX_UPLOAD_MB=50

# CORS: comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
